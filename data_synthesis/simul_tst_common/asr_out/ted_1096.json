": 0.0, "avg_logprob": -0.23923973603682083, "compression_ratio": 1.2873563218390804, "no_speech_prob": 0.18798458576202393}, {"id": 51, "seek": 21810, "start": 223.46, "end": 224.46, "text": " Thank you.", "tokens": [50631, 6952, 345, 13, 50681], "temperature": 0.0, "avg_logprob": -0.23923973603682083, "compression_ratio": 1.2873563218390804, "no_speech_prob": 0.18798458576202393}, {"id": 52, "seek": 21810, "start": 224.46, "end": 225.46, "text": " Come back.", "tokens": [50681, 7911, 736, 13, 50731], "temperature": 0.0, "avg_logprob": -0.23923973603682083, "compression_ratio": 1.2873563218390804, "no_speech_prob": 0.18798458576202393}, {"id": 53, "seek": 21810, "start": 225.46, "end": 226.45999999999998, "text": " Come back.", "tokens": [50731, 7911, 736, 13, 50781], "temperature": 0.0, "avg_logprob": -0.23923973603682083, "compression_ratio": 1.2873563218390804, "no_speech_prob": 0.18798458576202393}, {"id": 54, "seek": 21810, "start": 226.45999999999998, "end": 226.48, "text": " Thank you.", "tokens": [50781, 6952, 345, 13, 50782], "temperature": 0.0, "avg_logprob": -0.23923973603682083, "compression_ratio": 1.2873563218390804, "no_speech_prob": 0.18798458576202393}, {"id": 55, "seek": 24810, "start": 249.1, "end": 253.54, "text": " Somewhere in America, there's a doctor who can peer into the future.", "tokens": [50413, 43808, 287, 2253, 11, 612, 338, 257, 6253, 508, 460, 12720, 656, 262, 2003, 13, 50635], "temperature": 0.0, "avg_logprob": -0.17507299387230063, "compression_ratio": 1.689795918367347, "no_speech_prob": 0.9179247617721558}, {"id": 56, "seek": 24810, "start": 253.54, "end": 258.18, "text": " There's a nurse who can access in an instant every patient's past.", "tokens": [50635, 1318, 338, 257, 15849, 508, 460, 1895, 287, 281, 9113, 790, 5827, 338, 1613, 13, 50867], "temperature": 0.0, "avg_logprob": -0.17507299387230063, "compression_ratio": 1.689795918367347, "no_speech_prob": 0.9179247617721558}, {"id": 57, "seek": 24810, "start": 258.18, "end": 