04635761589404, "no_speech_prob": 0.010154369287192822}, {"id": 39, "seek": 21640, "start": 226.4, "end": 245.0, "text": " Amanda is wearing our Elex like I said, it has sensors, it's completely non-invasive", "tokens": [50863, 23040, 318, 5762, 674, 412, 2588, 588, 314, 531, 11, 340, 468, 15736, 11, 340, 338, 3190, 1729, 12, 259, 23747, 51793], "temperature": 0.0, "avg_logprob": -0.37069861094156903, "compression_ratio": 1.304635761589404, "no_speech_prob": 0.010154369287192822}, {"id": 40, "seek": 24500, "start": 245.04, "end": 250.52, "text": " sensors in the crutches that send signals back to an on-board computer that is sitting", "tokens": [50365, 15736, 287, 262, 1067, 315, 2052, 326, 3758, 10425, 736, 284, 281, 319, 12, 3526, 3644, 326, 318, 5586, 50639], "temperature": 0.0, "avg_logprob": -0.2079351797871206, "compression_ratio": 1.6336633663366336, "no_speech_prob": 0.049879394471645355}, {"id": 41, "seek": 24500, "start": 250.52, "end": 256.8, "text": " here at her back, there are battery packs here as well that power motors that are sitting", "tokens": [50639, 994, 379, 607, 736, 11, 612, 389, 6555, 15186, 994, 355, 880, 326, 1176, 24699, 326, 389, 5586, 50953], "temperature": 0.0, "avg_logprob": -0.2079351797871206, "compression_ratio": 1.6336633663366336, "no_speech_prob": 0.049879394471645355}, {"id": 42, "seek": 24500, "start": 256.8, "end": 263.84, "text": " at her hips, as well as her knee joints that move her forward in this kind of smooth and", "tokens": [50953, 379, 607, 21497, 11, 355, 880, 355, 607, 10329, 24039, 326, 1445, 607, 2651, 287, 428, 1611, 286, 7209, 290, 51305], "temperature": 0.0, "avg_logprob": -0.2079351797871206, "compression_ratio": 1.6336633663366336, "no_speech_prob": 0.049879394471645355}, {"id": 43, "seek": 24500, "start": 263.84, "end": 268.6, "text": " very natural gait.", "tokens": [51305, 845, 3288, 308, 4548, 13, 51543], "temperature": 0.0, "avg_logprob": -0.2079351797871206, "compression_ratio": 1.6336633663366336, "no_speech_prob": 0.049879394471645355}, {"id": 44, "seek": 24500, "start": 268.6, "end": 272.84, "text": " I was 24 years old and at the top of my game.", "tokens": [51543, 314, 373, 1987, 812, 1468, 290, 379, 262, 1353, 286, 616, 983, 13, 51755], "temperature": 0.0, "avg_logprob": -0.2079351797871206, "compression_ratio": 1.6336633663366336, "no_speech_prob": 0.049879394471645355}, {"id": 45, "seek": 27284, "start": 272.84, "end": 278.21999999999997, "text": " And a freak somersault while downhill skiing paralyzed me.", "tokens": [50363, 843, 257, 22601, 3870, 364, 1721, 981, 35390, 41348, 36175, 502, 13, 50632], "temperature": 0.0, "avg_logprob": -0.14748408089221363, "compression_ratio": 1.3903743315508021, "no_speech_prob": 0.013090940192341805}, {"id": 46, "seek": 27284, "start": 278.21999999999997, "end": 285.96, "text": " In a split second, I lost all sensation and movement below my pelvis.", "tokens": [50632, 554, 257, 6626, 1218, 11, 314, 2626, 477, 18098, 290, 3356, 2174, 616, 16176, 4703, 13, 51019], "temperature": 0.0, "avg_logprob": -0.14748408089221363, "compression_ratio": 1.3903743315508021, "no_speech_prob": 0.013090940192341805}, {"id": 47, "seek": 27284, "start": 285.96, "end": 293.47999999999996, "text": " Not long afterwards, a doctor strode into my hospital room and he said, Amanda, you'll", "tokens": [51019, 1892, 890, 12979, 11, 257, 6253, 9660, 2934, 656, 616, 4436, 2119, 290, 339, 531, 11, 23040, 11, 345, 1183, 51395], "temperature": 0.0, "avg_logprob": -0.14748408089221363, "compression_ratio": 1.3903743315508021, "no_speech_prob": 0.013090940192341805}, {"id": 48, "seek": 27284, "start": 293.47999999999996, "end": 297.0, "text": " never walk again.", "tokens": [51395, 1239, 2513, 757, 13, 51571], "temperature": 0.0, "avg_logprob": -0.14748408089221363, "compression_ratio": 1.3903743315508021, "no_speech_prob": 0.013090940192341805}, {"id": 49, "seek": 27284, "start": 297.0, "end": 300.52, "text": " And that was 19 years ago.", "tokens": [51571, 843, 326, 373, 678, 812, 2084, 13, 51747], "temperature": 0.0, "avg_logprob": -0.14748408089221363, "compression_ratio": 1.3903743315508021, "no_speech_prob": 0.013090940192341805}, {"id": 50, "seek": 30052, "start": 300.52, "end": 305.96, "text": " He robbed every ounce of hope from my being.", "tokens": [50363, 679, 26773, 790, 25799, 286, 2911, 422, 616, 852, 13, 50635], "temperature": 0.0, "avg_logprob": -0.15911178235654477, "compression_ratio": 1.4350649350649352, "no_speech_prob": 0.0051085264421999454}, {"id": 51, "seek": 30052, "start": 305.96, "end": 312.76, "text": " Adaptive technology has since enabled me to learn how to downhill ski again, to rock climb", "tokens": [50635, 30019, 425, 3037, 468, 1201, 9343, 502, 284, 2193, 703, 284, 35390, 19984, 757, 11, 284, 3881, 12080, 50975], "temperature": 0.0, "avg_logprob": -0.15911178235654477, "compression_ratio": 1.4350649350649352, "no_speech_prob": 0.0051085264421999454}, {"id": 52, "seek": 30052, "start": 312.76, "end": 325.76, "text": " and even hand cycle, but nothing has been invented that enables me to walk until now.", "tokens": [50975, 290, 772, 1021, 6772, 11, 475, 2147, 468, 587, 15646, 326, 13536, 502, 284, 2513, 1566, 783, 13, 51625], "temperature": 0.0, "avg_logprob": -0.15911178235654477, "compression_ratio": 1.4350649350649352, "no_speech_prob": 0.0051085264421999454}, {"id": 53, "seek": 32576, "start": 325.76, "end": 343.4, "text": " As you can see, we have the technology, we have the platforms to sit down and have discussions", "tokens": [50363, 1081, 345, 460, 766, 11, 356, 423, 262, 3037, 11, 356, 423, 262, 9554, 284, 1650, 866, 290, 423, 9984, 51245], "temperature": 0.0, "avg_logprob": -0.16061122894287108, "compression_ratio": 1.4776119402985075, "no_speech_prob": 0.02060883305966854}, {"id": 54, "seek": 32576, "start": 343.4, "end": 345.64, "text": " with you.", "tokens": [51245, 351, 345, 13, 51357], "temperature": 0.0, "avg_logprob": -0.16061122894287108, "compression_ratio": 1.4776119402985075, "no_speech_prob": 0.02060883305966854}, {"id": 55, "seek": 32576, "start": 345.64, "end": 354.8, "text": " It's in our hands and we have all the potential here to change the life of future generations", "tokens": [51357, 632, 338, 287, 674, 2832, 290, 356, 423, 477, 262, 2785, 994, 284, 1487, 262, 1204, 286, 2003, 10439, 51815], "temperature": 0.0, "avg_logprob": -0.16061122894287108, "compression_ratio": 1.4776119402985075, "no_speech_prob": 0.02060883305966854}, {"id": 56, "seek": 35480, "start": 354.8, "end": 363.28000000000003, "text": " not only for the soldiers or for Amanda here and all the VLC users, but for everyone.", "tokens": [50363, 407, 691, 329, 262, 5795, 393, 329, 23040, 994, 290, 477, 262, 569, 5639, 2985, 11, 475, 329, 2506, 13, 50787], "temperature": 0.0, "avg_logprob": -0.23199373742808466, "compression_ratio": 1.0493827160493827, "no_speech_prob": 0.9517101049423218}], "language": "en"}