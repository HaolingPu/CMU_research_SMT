      "character_edits": [
        {
          "op": "insert",
          "start": 14,
          "end": 14,
          "text": " Drucker, and she was breathless, and when I listened to her, she was making a wheezy sound."
        }
      ]
    },
    {
      "op": "delete_line",
      "line_hash": "f139dd0736665cc1b2ec507eb9e46b86c6e477e2dad8de4180a52fcd69489f7b"
