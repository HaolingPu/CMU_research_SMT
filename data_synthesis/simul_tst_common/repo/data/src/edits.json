      "character_edits": [
        {
          "op": "insert",
          "start": 0,
          "end": 0,
          "text": "I was a resident at a teaching hospital here in Toronto when Mrs. "
        },
        {
          "op": "insert",
          "start": 7,
          "end": 7,
          "text": " was brought to the emergency department at the hospital where I was working"
