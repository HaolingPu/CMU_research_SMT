      "character_edits": [
        {
          "op": "insert",
          "start": 98,
          "end": 98,
          "text": " Drucker, do you think it's okay if she goes home?"
        }
      ]
    },
    {
      "op": "delete_line",
      "line_hash": "7160526dd5502677e983cb4275774d732f0c4e1f5b9d34c7ca2ad4aeebd839de"
