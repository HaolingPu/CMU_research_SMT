+def append_doc_align_info(entry, fp):
+    """
+    Append a single doc's alignment records to an open file pointer and flush.
+    Used for incremental write so timeouts don't lose progress.
+    """
+    for i, (aligned_src, aligned_ref, aligned_mt) in enumerate(entry["ref_aligned"]):
+        record = {
+            "doc_id": entry["doc_id"],
+            "sys_id": entry["sys_id"],
+            "src": aligned_src,
+            "ref": aligned_ref,
+            "tgt": aligned_mt,
+            "seg_id": i + 1,
+        }
+        json.dump(record, fp, ensure_ascii=False)
+        fp.write("\n")
+    fp.flush()
+    try:
+        os.fsync(fp.fileno())
+    except OSError:
+        pass
+
+
+def load_done_doc_ids(aligned_file, failure_file):
+    """
+    Read existing aligned and failure files to recover doc_ids already processed.
+    Used for resume after a previous timeout.
+    """
+    done = set()
+    if os.path.exists(aligned_file):
+        with open(aligned_file, "r", encoding="utf-8") as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    done.add(json.loads(line)["doc_id"])
+                except Exception:
+                    pass
+    if os.path.exists(failure_file):
+        with open(failure_file, "r", encoding="utf-8") as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    done.add(json.loads(line))
+                except Exception:
+                    pass
+    return done
+
